# Private working files (plans, notes; not for publication)
local/

# Node / build
node_modules/
dist/
web-dist/
web-dist-offline/
dist-cli/
dist-release/
# deno compile output
/stegoshard
/stegoshard-*
build/
coverage/
packages/
playwright-report/
test-results/
blob-report/
*.log

# Python (reference decoder)
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
# Generated conformance fixtures (produced by `npm run fixtures`)
python/tests/_fixtures/

# IDE / editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets / local config
.env
.env.*
!.env.example
!.env.store
*.key
# ...except in the golden corpus, which must hold exactly what the app writes.
# Everything under tests/golden is generated test data with a published password;
# the blanket rule above still covers real key material everywhere else. Without
# this, keyfile mode was pinned by four PNGs and no key, and the corpus test
# passed locally on an untracked file while failing in a fresh checkout.
!tests/golden/**/*.key

# Stryker output and its incremental cache.
reports/
.stryker-tmp/
