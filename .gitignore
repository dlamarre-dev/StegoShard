# Private working files (plans, notes; not for publication)
local/

# Node / build
node_modules/
dist/
web-dist/
web-dist-offline/
dist-cli/
dist-lib/
dist-release/
# Staging tree for the library's declaration rollup (tsconfig.lib.json), plus
# api-extractor's scratch copy of the report. The report itself, under docs/api/,
# IS committed: it is the reviewable record of the public surface.
.types/
# deno compile output
/stegoshard
/stegoshard-*
build/
coverage/
packages/
playwright-report/
test-results/
blob-report/
*.log

# Python (reference decoder)
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
# Generated conformance fixtures (produced by `npm run fixtures`)
python/tests/_fixtures/

# IDE / editor
.idea/
# JetBrains 'Export to HTML': a rendering of a source file, not a source file.
exportToHTML/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets / local config
.env
.env.*
!.env.example
!.env.store
*.key
# ...except in the golden corpus, which must hold exactly what the app writes.
# Everything under tests/golden is generated test data with a published password;
# the blanket rule above still covers real key material everywhere else. Without
# this, keyfile mode was pinned by four PNGs and no key, and the corpus test
# passed locally on an untracked file while failing in a fresh checkout.
!tests/golden/**/*.key

# Stryker output and its incremental cache.
reports/
.stryker-tmp/

# NOTE: `.bundled/` is deliberately NOT ignored. Each build writes the list of
# npm packages it inlined, and generate-notices.ts reads them, so the lists are
# committed for two reasons: `ci:node` runs `notices:check` before any build has
# happened, and a change to what we distribute should be a reviewable diff rather
# than something that only appears in a regenerated notices file.
