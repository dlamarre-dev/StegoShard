  "cards": [
    {
      "dot": "emerald",
      "title": "Why losses are survivable",
      "items": [
        "Reed-Solomon adds 30% parity, floor of two shards",
        "Any k of the k + m carriers rebuild the blob"
      ]
    },
    {
      "dot": "cyan",
      "title": "Why a stranger cannot break it",
      "items": [
        "Foreign or corrupt carriers are dropped by majority set",
        "Alternative k-subsets are retried before giving up"
      ]
    },
    {
      "dot": "rose",
      "title": "What it refuses to do",
      "items": [
        "A photo cover is never used twice under one password",
        "A wrong password yields nothing, not a partial file"
      ]
    }
